{
  "name": "rangeboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "library:build": "node scripts/build-library.mjs",
    "library:check": "node scripts/build-library.mjs --check && node scripts/check-library.mjs && node scripts/derive-priors.mjs --check",
    "priors:build": "node scripts/derive-priors.mjs",
    "check:library": "npm run library:check",
    "schema:generate": "node src/io/generateRuntimeSchema.mjs",
    "schema:check": "node src/io/generateRuntimeSchema.mjs --check",
    "docs:lint": "markdownlint-cli2",
    "docs:fix": "markdownlint-cli2 --fix",
    "docs:check": "npm run docs:lint && node scripts/check-docs.mjs",
    "docs:review": "node scripts/check-docs.mjs --review",
    "test:docs": "node --test scripts/test-docs.mjs",
    "test:e2e": "node --test scripts/e2e/board-shell.e2e.mjs",
    "test:bundle": "node --test scripts/test-bundle.mjs",
    "engine:build": "vite build --config vite.engine.config.ts",
    "engine": "node scripts/run-engine.mjs",
    "test:engine": "node --test scripts/test-engine-cli.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run docs:check && npm run test:docs && npm run test:bundle && npm run test:engine && npm run library:check && npm run typecheck && npm run schema:check && npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "konva": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "recharts": "3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "markdownlint-cli2": "0.23.2",
    "markdownlint-rule-relative-links": "5.1.2",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
